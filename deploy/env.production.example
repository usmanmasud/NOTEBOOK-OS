# Production environment for Huawei Cloud. Copy to deploy/.env.production (never commit it).

PUBLIC_BASE_URL=https://notebookos.example.com
CORS_ORIGINS=https://notebookos.example.com
LOG_LEVEL=INFO

# Huawei Cloud RDS for MySQL — private VPC address of the instance.
DATABASE_URL=mysql+pymysql://notebookos:CHANGE_ME@192.168.0.10:3306/notebookos?charset=utf8mb4

# Huawei Cloud DCS for Redis — private VPC address. Use rediss:// if SSL is enabled.
REDIS_URL=redis://:CHANGE_ME@192.168.0.20:6379/0

# Huawei Cloud OBS (private bucket; files are served through the API only).
STORAGE_BACKEND=obs
OBS_ENDPOINT=https://obs.ap-southeast-1.myhuaweicloud.com
OBS_REGION=ap-southeast-1
OBS_BUCKET=notebookos-uploads
OBS_ACCESS_KEY_ID=CHANGE_ME
OBS_SECRET_ACCESS_KEY=CHANGE_ME

# AI providers. "huawei,demo" tries Huawei Cloud OCR first and falls back to the
# offline demo fixtures (which only recognise the bundled fictional samples).
OCR_PROVIDER=huawei,demo
SPEECH_PROVIDER=huawei,demo
HUAWEI_REGION=ap-southeast-1
HUAWEI_PROJECT_ID=CHANGE_ME
HUAWEI_IAM_DOMAIN=CHANGE_ME
HUAWEI_IAM_USER=CHANGE_ME
HUAWEI_IAM_PASSWORD=CHANGE_ME
HUAWEI_SIS_LANGUAGE=en_us

# Optional LLM (OpenAI-compatible endpoint, e.g. ModelArts MaaS). Rules are the fallback.
LLM_PROVIDER=rules
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_TO_RULES=true

# Demo account for the competition. Set to false for real traders.
DEMO_MODE=true

CURRENCY=NGN
LOCALE=en-NG
TIMEZONE=Africa/Lagos
EXTRACTION_LANGUAGES=en,ha
