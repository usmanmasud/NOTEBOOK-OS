# Production environment for Huawei Cloud ECS + RDS.
# deploy/ecs-setup.sh copies this to deploy/.env.production (never commit that file).
# Replace every CHANGE_ME.

# Public address. With no domain, use the ECS public IP with dashes + .sslip.io
# e.g. EIP 1.2.3.4  ->  DOMAIN=1-2-3-4.sslip.io
DOMAIN=CHANGE_ME.sslip.io
PUBLIC_BASE_URL=https://CHANGE_ME.sslip.io
CORS_ORIGINS=https://CHANGE_ME.sslip.io
LOG_LEVEL=INFO

# Huawei Cloud RDS for MySQL: private (VPC) IP of the instance and the account you created.
DATABASE_URL=mysql+pymysql://notebookos:CHANGE_ME@CHANGE_ME:3306/notebookos?charset=utf8mb4

# Redis container on the same ECS (or a Huawei DCS address).
REDIS_URL=redis://redis:6379/0

# Uploaded notebook photos: ECS disk by default. For OBS set STORAGE_BACKEND=obs and the OBS_* values.
STORAGE_BACKEND=local
OBS_ENDPOINT=
OBS_REGION=
OBS_BUCKET=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=

# AI providers. "huawei,demo" tries Huawei Cloud OCR first, then the offline demo reader.
OCR_PROVIDER=demo
SPEECH_PROVIDER=demo
HUAWEI_REGION=af-south-1
HUAWEI_PROJECT_ID=
HUAWEI_IAM_DOMAIN=
HUAWEI_IAM_USER=
HUAWEI_IAM_PASSWORD=
HUAWEI_SIS_LANGUAGE=en_us

# LLM for the UNDERSTAND stage (e.g. Huawei ModelArts MaaS, OpenAI-compatible). Rules are the fallback.
LLM_PROVIDER=rules
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_TO_RULES=true

# Demo account with fictional data (used for judging). Phone sign-in needs an SMS gateway.
DEMO_MODE=true

CURRENCY=NGN
LOCALE=en-NG
TIMEZONE=Africa/Lagos
EXTRACTION_LANGUAGES=en,ha
