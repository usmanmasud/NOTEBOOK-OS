# NotebookOS configuration. Copy to `.env` and adjust. Never commit `.env`.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
# Local default (if unset): SQLite file in backend/data/.
# Production (Huawei Cloud RDS for MySQL, private VPC address):
# DATABASE_URL=mysql+pymysql://notebookos:<password>@<rds-private-ip>:3306/notebookos?charset=utf8mb4
DATABASE_URL=

# --- Cache / sessions (Huawei Cloud DCS for Redis in production) ------------
# Empty = in-process store (single process only).
REDIS_URL=

# --- File storage -------------------------------------------------------------
# local | obs
STORAGE_BACKEND=local
OBS_ENDPOINT=https://obs.ap-southeast-1.myhuaweicloud.com
OBS_BUCKET=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_REGION=ap-southeast-1

# --- Auth ---------------------------------------------------------------------
SESSION_TTL_MINUTES=720
OTP_TTL_SECONDS=300
# Development only: return OTP in the API response. Must be false in production.
OTP_DEV_ECHO=true

# --- Demo mode (fictional data, offline-capable) ------------------------------
DEMO_MODE=true

# --- AI providers ---------------------------------------------------------------
# OCR:    demo | huawei | tesseract | none
# Speech: demo | huawei | none
# LLM:    rules | openai_compatible
OCR_PROVIDER=demo
SPEECH_PROVIDER=demo
LLM_PROVIDER=rules
LLM_FALLBACK_TO_RULES=true

# OpenAI-compatible chat completions endpoint (e.g. Huawei Cloud ModelArts MaaS).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Huawei Cloud OCR / SIS credentials (IAM user with only the needed permissions).
HUAWEI_REGION=ap-southeast-1
HUAWEI_PROJECT_ID=
HUAWEI_IAM_DOMAIN=
HUAWEI_IAM_USER=
HUAWEI_IAM_PASSWORD=
HUAWEI_SIS_LANGUAGE=en_us

# --- Market / localisation --------------------------------------------------------
CURRENCY=NGN
LOCALE=en-NG
TIMEZONE=Africa/Lagos
EXTRACTION_LANGUAGES=en,ha

# --- Validation thresholds ------------------------------------------------------------
CONFIDENCE_HIGH=0.85
CONFIDENCE_REVIEW=0.60
SUSPICIOUS_AMOUNT=5000000
DATE_ORDER=DMY
